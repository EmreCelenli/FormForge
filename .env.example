# Backend
MOCK=0
POSE_BACKEND=mediapipe
DATA_DIR=./data
MAX_UPLOAD_MB=100

# AMD Token Factory (notebooks.amd.com/tokenfactory).
# Fill BASE_URL and API_KEY from the console after sign-in. Do not commit real keys.
TOKEN_FACTORY_BASE_URL=
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_MODEL_ID=Gemma-4-31B-IT
TOKEN_FACTORY_VISION_MODEL_ID=MiniCPM-V-4.7-1B
TOKEN_FACTORY_VISION_FALLBACK_MODEL_ID=DeepSeek-V4-Flash-Vision-Exp

# Gradium text-to-speech. The key stays server-side.
# One heard library voice per ISO 639-1 language: en, fr, es, de, pt.
# Leave a language empty until that voice has been heard. That language stays text-only.
# GRADIUM_VOICE_ID is the English voice when GRADIUM_VOICE_ID_EN is empty.
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
GRADIUM_VOICE_ID_EN=
GRADIUM_VOICE_ID_FR=
GRADIUM_VOICE_ID_ES=
GRADIUM_VOICE_ID_DE=
GRADIUM_VOICE_ID_PT=
GRADIUM_TTS_URL=https://api.gradium.ai/api/post/speech/tts

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
